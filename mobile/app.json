{
  "expo": {
    "name": "Margdarshak",
    "slug": "margdarshak",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "careerguide",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.csp.margdarshak",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#315D48",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73f5d874-ee3d-4c82-8944-2b80dd690a3f"
      }
    }
  }
}
